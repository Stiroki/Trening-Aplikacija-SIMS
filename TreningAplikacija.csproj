<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\AdminWIndow.axaml.cs">
      <DependentUpon>AdminWindow.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\ClientMainWindow.axaml.cs">
      <DependentUpon>ClientMainWindow.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\TrainerMainWindow.axaml.cs">
      <DependentUpon>TrainerMainWindow.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\CreateTrainingWindow.axaml.cs">
      <DependentUpon>CreateTrainingWindow.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
