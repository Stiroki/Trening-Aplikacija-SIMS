<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TreningAplikacija.ViewModels"
        x:Class="TreningAplikacija.Views.NotificationsWindow"
        x:DataType="vm:NotificationsViewModel"
        x:CompileBindings="False"
        Title="Notifikacije" Width="500" Height="450"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="10">

            <TextBlock Text="Notifikacije" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <Button Content="Označi sve kao pročitano"
                    Command="{Binding MarkAllAsReadCommand}"
                    HorizontalAlignment="Right"
                    Background="Gray" Foreground="White" Padding="10,4"/>

            <TextBlock Text="Nemate notifikacija." IsVisible="{Binding HasNoNotifications}"
                       HorizontalAlignment="Center" Foreground="Gray" FontStyle="Italic"/>

            <ItemsControl ItemsSource="{Binding Notifications}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,0,0,8"
                                CornerRadius="4">
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="● " Foreground="#007ACC"
                                               IsVisible="{Binding !IsRead}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Message}"
                                               FontWeight="Bold"
                                               IsVisible="{Binding !IsRead}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Message}"
                                               IsVisible="{Binding IsRead}"
                                               Foreground="Gray"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Date, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                               Foreground="Gray" FontSize="11"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Nazad" Command="{Binding BackCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="Transparent" Margin="0,15,0,0"/>

        </StackPanel>
    </ScrollViewer>
</Window>