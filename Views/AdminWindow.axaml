<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TreningAplikacija.ViewModels"
        xmlns:conv="using:TreningAplikacija.Converters"
        x:Class="TreningAplikacija.Views.AdminWindow"
        x:DataType="vm:AdminViewModel"
        x:CompileBindings="False"
        Title="Admin"
        Width="800" Height="600">
    <Window.Resources>
        <conv:GuidToTrainerNameConverter x:Key="TrainerNameConverter" />
        <conv:GuidToClientNameConverter x:Key="ClientNameConverter" />
    </Window.Resources>
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="15">
            <TextBlock Text="{Binding WelcomeMessage}" FontSize="20" FontWeight="Bold" />

            <TextBlock Text="Prijave trenera na čekanju" FontSize="16" Margin="0,10,0,0" />

            <ItemsControl ItemsSource="{Binding PendingTrainers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding LastName}" />
                                    <TextBlock Text="{Binding Email}" Foreground="Gray" />
                                </StackPanel>

                                <Button Grid.Column="1" Content="Prihvati" Margin="10,0"
                                        Command="{Binding DataContext.ApproveTrainerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Green" Foreground="White" />

                                <Button Grid.Column="2" Content="Odbij"
                                        Command="{Binding DataContext.RejectTrainerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Red" Foreground="White" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Prijave klijenata na čekanju" FontSize="16" Margin="0,20,0,0" />

            <ItemsControl ItemsSource="{Binding PendingClients}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding LastName}" />
                                    <TextBlock Text="{Binding Email}" Foreground="Gray" />
                                </StackPanel>

                                <Button Grid.Column="1" Content="Prihvati" Margin="10,0"
                                        Command="{Binding DataContext.ApproveClientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Green" Foreground="White" />

                                <Button Grid.Column="2" Content="Odbij"
                                        Command="{Binding DataContext.RejectClientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Red" Foreground="White" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Zakasnele uplate" FontSize="16" Margin="0,20,0,0" />

            <ItemsControl ItemsSource="{Binding OverduePayments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="OrangeRed" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Period}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Amount, StringFormat='Iznos: {0} RSD'}" />
                                    <TextBlock Text="{Binding DueDate, StringFormat='Rok: {0:d}'}" Foreground="Gray" />
                                </StackPanel>

                                <Button Grid.Column="1" Content="Označi kao plaćeno"
                                        Command="{Binding DataContext.MarkPaymentAsPaidCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Green" Foreground="White" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Provizije trenera" FontSize="16" Margin="0,20,0,0" />

            <ItemsControl ItemsSource="{Binding CommissionPayments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Period}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Amount, StringFormat='Iznos: {0} RSD'}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" Margin="10,0" />

                                <Button Grid.Column="2" Content="Označi kao plaćeno"
                                        Command="{Binding DataContext.MarkPaymentAsPaidCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Green" Foreground="White" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Treneri (sortirano po oceni)" FontSize="16" Margin="0,20,0,0" />

            <ItemsControl ItemsSource="{Binding AllTrainersByRating}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding LastName}" />
                                    <TextBlock Text="{Binding AverageRating, StringFormat='Ocena: {0:F1}'}" />
                                    <TextBlock Text="{Binding WarningCount, StringFormat='Upozorenja: {0}'}" Foreground="OrangeRed" />
                                </StackPanel>

                                <Button Grid.Column="2" Content="Upozori" Margin="10,0"
                                        Command="{Binding DataContext.WarnTrainerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Orange" Foreground="White" />

                                <Button Grid.Column="3" Content="Ukloni"
                                        Command="{Binding DataContext.RemoveTrainerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Red" Foreground="White" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Sve recenzije" FontSize="16" Margin="0,20,0,0" />

            <ItemsControl ItemsSource="{Binding AllReviews}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock FontWeight="Bold">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} ocenio(la) trenera {1}">
                                            <Binding Path="ReviewerId" Converter="{StaticResource ClientNameConverter}" ConverterParameter="{Binding $parent[ItemsControl].DataContext}" />
                                            <Binding Path="RevieweeId" Converter="{StaticResource TrainerNameConverter}" ConverterParameter="{Binding $parent[ItemsControl].DataContext}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text="{Binding Rating, StringFormat='Ocena: {0}/5'}" />
                                <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Date, StringFormat='{}{0:d}'}" Foreground="Gray" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding StatusMessage}" Foreground="Blue" />
        </StackPanel>
    </ScrollViewer>
</Window>