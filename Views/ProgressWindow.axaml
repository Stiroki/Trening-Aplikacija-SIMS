<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TreningAplikacija.ViewModels"
        x:Class="TreningAplikacija.Views.ProgressWindow"
        x:DataType="vm:ProgressViewModel"
        x:CompileBindings="False"
        Title="Praćenje napretka" Width="600" Height="600"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="10">

            <TextBlock Text="Praćenje napretka" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <!-- Forma za unos -->
            <TextBlock Text="Novo merenje:" FontWeight="SemiBold" FontSize="16"/>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,10">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,5,8">
                    <TextBlock Text="Težina (kg)"/>
                    <NumericUpDown Value="{Binding Weight}" Minimum="0" Maximum="300"
                                   Increment="0.5" FormatString="0.0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="5,0,0,8">
                    <TextBlock Text="Grudi (cm)"/>
                    <NumericUpDown Value="{Binding Chest}" Minimum="0" Maximum="200"
                                   Increment="0.5" FormatString="0.0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,0,5,8">
                    <TextBlock Text="Struk (cm)"/>
                    <NumericUpDown Value="{Binding Waist}" Minimum="0" Maximum="200"
                                   Increment="0.5" FormatString="0.0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" Margin="5,0,0,8">
                    <TextBlock Text="Kukovi (cm)"/>
                    <NumericUpDown Value="{Binding Hips}" Minimum="0" Maximum="200"
                                   Increment="0.5" FormatString="0.0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2" Margin="0,0,5,8">
                    <TextBlock Text="Biceps (cm)"/>
                    <NumericUpDown Value="{Binding Biceps}" Minimum="0" Maximum="100"
                                   Increment="0.5" FormatString="0.0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2" Margin="5,0,0,8">
                    <TextBlock Text="Butina (cm)"/>
                    <NumericUpDown Value="{Binding Thigh}" Minimum="0" Maximum="100"
                                   Increment="0.5" FormatString="0.0"/>
                </StackPanel>
            </Grid>

            <TextBox Text="{Binding Comment}" Watermark="Komentar (opciono)"
                     Height="50" AcceptsReturn="True" TextWrapping="Wrap"/>

            <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding IsStatusVisible}"
                       HorizontalAlignment="Center" FontWeight="Bold" Foreground="#007ACC"/>

            <Button Content="Sačuvaj merenje" Command="{Binding AddEntryCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#007ACC" Foreground="White" Padding="10,8"/>

            <!-- Separator -->
            <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Margin="0,10"/>

            <!-- Istorija -->
            <TextBlock Text="Istorija merenja:" FontWeight="SemiBold" FontSize="16"/>

            <TextBlock Text="Nema prethodnih merenja." IsVisible="{Binding HasNoEntries}"
                       HorizontalAlignment="Center" Foreground="Gray" FontStyle="Italic"/>

            <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,0,0,8"
                                CornerRadius="4">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Date, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                           FontWeight="Bold"/>
                                <Grid ColumnDefinitions="*,*,*">
                                    <TextBlock Grid.Column="0" Text="{Binding Weight, StringFormat='Težina: {0:F1} kg'}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Chest, StringFormat='Grudi: {0:F1} cm'}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Waist, StringFormat='Struk: {0:F1} cm'}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*">
                                    <TextBlock Grid.Column="0" Text="{Binding Hips, StringFormat='Kukovi: {0:F1} cm'}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Biceps, StringFormat='Biceps: {0:F1} cm'}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Thigh, StringFormat='Butina: {0:F1} cm'}"/>
                                </Grid>
                                <TextBlock Text="{Binding Comment, StringFormat='Komentar: {0}'}"
                                           Foreground="Gray" FontStyle="Italic"
                                           IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Nazad" Command="{Binding BackCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="Transparent" Margin="0,15,0,0"/>

        </StackPanel>
    </ScrollViewer>
</Window>