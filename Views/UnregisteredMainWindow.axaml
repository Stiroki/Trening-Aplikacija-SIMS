<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TreningAplikacija.ViewModels"
        x:Class="TreningAplikacija.Views.UnregisteredMainWindow"
        x:DataType="vm:UnregisteredMainViewModel"
        x:CompileBindings="False"
        Title="Pregled za goste" Width="800" Height="600"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" Background="#2D2D30" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="← Nazad na prijavu" Command="{Binding BackToLoginCommand}" 
                        Background="Transparent" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="Režim za goste (Samo čitanje)" Foreground="LightGray" 
                           VerticalAlignment="Center" Margin="20,0,0,0" FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="10">
            
            <TabItem Header="Spisak Trenera">
                <ListBox ItemsSource="{Binding Trainers}" Margin="0,10,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name, StringFormat='Ime: {0}'}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding LastName, StringFormat='Prezime: {0}'}"/>
                                    <TextBlock Text="{Binding AverageRating, StringFormat='Prosečna ocena: {0:F1}'}" Foreground="Gold"/>
                                    <TextBlock Text="{Binding MonthlyFee, StringFormat='Mesečna članarina: {0} RSD'}" Foreground="LightGreen"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem Header="Primeri Vežbi">
                <ListBox ItemsSource="{Binding Exercises}" Margin="0,10,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem Header="Recenzije korisnika">
                <ListBox ItemsSource="{Binding Reviews}" Margin="0,10,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding Rating, StringFormat='Ocena: {0}/5'}" FontWeight="Bold" Foreground="Gold"/>
                                    <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

        </TabControl>
    </Grid>
</Window>

