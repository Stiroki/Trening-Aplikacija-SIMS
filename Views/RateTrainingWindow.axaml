<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TreningAplikacija.ViewModels"
        x:Class="TreningAplikacija.Views.RateTrainingWindow"
        x:DataType="vm:RateTrainingViewModel"
        x:CompileBindings="False"
        Title="Oceni trening" Width="600" Height="600"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="10">

            <TextBlock Text="{Binding HeaderText}" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <!-- Pojedinačne vežbe (ocena 10) -->
            <TextBlock Text="Oceni vežbe (opciono):" FontWeight="SemiBold" FontSize="16"/>

            <ItemsControl ItemsSource="{Binding Exercises}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,0,0,8"
                                CornerRadius="4">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Exercise.Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Exercise.Description}" Foreground="Gray"
                                           FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Foreground="Gray" FontSize="12">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} x {1} | {2}">
                                            <Binding Path="Item.Sets"/>
                                            <Binding Path="Item.Reps"/>
                                            <Binding Path="Item.Duration"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <TextBlock Text="Ocena (1-5):" VerticalAlignment="Center"/>
                                    <NumericUpDown Value="{Binding Rating}" Minimum="1" Maximum="5"
                                                   Increment="1" Width="100" FormatString="0"/>
                                </StackPanel>

                                <TextBox Text="{Binding Comment}" Watermark="Komentar (opciono)"
                                         Height="40"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Separator -->
            <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Margin="0,10"/>

            <!-- Ocena celog treninga (ocena 9) -->
            <TextBlock Text="Oceni ceo trening:" FontWeight="SemiBold" FontSize="16"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Ocena (1-5):" VerticalAlignment="Center"/>
                <NumericUpDown Value="{Binding OverallRating}" Minimum="1" Maximum="5"
                               Increment="1" Width="100" FormatString="0"/>
            </StackPanel>

            <TextBox Text="{Binding OverallComment}" Watermark="Komentar (obavezno)"
                     Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>

            <!-- Status poruka -->
            <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding IsStatusVisible}"
                       Foreground="OrangeRed" HorizontalAlignment="Center" FontWeight="Bold"/>

            <!-- Dugmad -->
            <Button Content="Završi trening i sačuvaj ocene"
                    Command="{Binding CompleteTrainingCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#007ACC" Foreground="White" Padding="10,8"
                    Margin="0,10,0,0"/>

            <Button Content="Nazad" Command="{Binding BackCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="Transparent"/>

        </StackPanel>
    </ScrollViewer>
</Window>