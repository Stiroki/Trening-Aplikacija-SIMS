<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TreningAplikacija.ViewModels"
        x:Class="TreningAplikacija.Views.MyTrainingsWindow"
        x:DataType="vm:MyTrainingsViewModel"
        x:CompileBindings="False"
        Title="Moji treninzi" Width="650" Height="550"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="10">

            <TextBlock Text="Moji treninzi" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Nemate nijedan trening." IsVisible="{Binding HasNoSessions}"
                       HorizontalAlignment="Center" Foreground="Gray" FontStyle="Italic"/>

            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,0,0,8"
                                CornerRadius="4">
                            <StackPanel Spacing="6">

                                <!-- Zaglavlje treninga - klik razvija/skuplja -->
                                <Button Command="{Binding ToggleExpandCommand}"
                                        Background="Transparent" Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Grid.Column="0" FontWeight="Bold"
                                                   Text="{Binding DateText, StringFormat='Trening - {0}'}"/>
                                        <TextBlock Grid.Column="1" Margin="10,0"
                                                   Text="{Binding StatusText}"
                                                   Foreground="Gray"/>
                                        <TextBlock Grid.Column="2" Text="{Binding OverallRatingText}"
                                                   Foreground="Orange"/>
                                    </Grid>
                                </Button>
                                
                                <Button Content="Oceni i završi"
                                        IsVisible="{Binding !Session.IsCompleted}"
                                        Command="{Binding DataContext.RateTrainingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="#007ACC" Foreground="White" Padding="8,4"
                                        HorizontalAlignment="Right" Margin="0,4,0,0"/>

                                <!-- Komentar na ceo trening -->
                                <TextBlock Text="{Binding Session.OverallComment, StringFormat='Komentar: {0}'}"
                                           IsVisible="{Binding HasOverallComment}"
                                           Foreground="Gray" FontStyle="Italic"
                                           Margin="10,0,0,0"/>

                                <!-- Lista vežbi - vidljiva kad je isExpanded -->
                                <ItemsControl ItemsSource="{Binding Items}"
                                              IsVisible="{Binding IsExpanded}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#15808080" Padding="10" Margin="10,4,0,0"
                                                    CornerRadius="3">
                                                <StackPanel Spacing="2">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" FontWeight="SemiBold"
                                                                   Text="{Binding Exercise.Name}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding SetsRepsText}"
                                                                   Foreground="Gray"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Exercise.Description}"
                                                               Foreground="Gray" FontSize="12"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Item.Duration, StringFormat='Odmor/trajanje: {0}'}"
                                                               Foreground="Gray" FontSize="12"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{Binding RatingText}"
                                                                   Foreground="Orange" FontSize="12"/>
                                                        <TextBlock Text="{Binding Item.ClientComment, StringFormat='- {0}'}"
                                                                   IsVisible="{Binding HasComment}"
                                                                   Foreground="Gray" FontSize="12"
                                                                   FontStyle="Italic"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Nazad" Command="{Binding BackCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="Transparent" Margin="0,15,0,0"/>

        </StackPanel>
    </ScrollViewer>
</Window>