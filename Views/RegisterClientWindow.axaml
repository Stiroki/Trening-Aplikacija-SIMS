<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TreningAplikacija.ViewModels"
        x:Class="TreningAplikacija.Views.RegisterClientWindow"
        x:DataType="vm:RegisterClientViewModel"
        x:CompileBindings="False"
        Title="Registracija klijenta" Width="450" Height="700"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer>
        <StackPanel Margin="30" Spacing="10">

            <TextBlock Text="Registracija" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Ime:" />
            <TextBox Text="{Binding Name}" PlaceholderText="Unesite ime..." />

            <TextBlock Text="Prezime:" />
            <TextBox Text="{Binding LastName}" PlaceholderText="Unesite prezime..." />

            <TextBlock Text="Email:" />
            <TextBox Text="{Binding Email}" PlaceholderText="Unesite email..." />

            <TextBlock Text="Lozinka:" />
            <TextBox Text="{Binding Password}" PasswordChar="*" PlaceholderText="Unesite lozinku..." />

            <TextBlock Text="Potvrda lozinke:" />
            <TextBox Text="{Binding ConfirmPassword}" PasswordChar="*" PlaceholderText="Ponovite lozinku..." />

            <TextBlock Text="Pol:" />
            <ComboBox SelectedItem="{Binding Gender}" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="muški" />
                <ComboBoxItem Content="ženski" />
            </ComboBox>

            <TextBlock Text="Datum rođenja:" />
            <DatePicker SelectedDate="{Binding DateOfBirth}" HorizontalAlignment="Stretch" />

            <TextBlock Text="Visina (cm):" />
            <TextBox Text="{Binding Height}" PlaceholderText="npr. 182" />

            <TextBlock Text="Težina (kg):" />
            <TextBox Text="{Binding Weight}" PlaceholderText="npr. 85" />

            <TextBlock Text="Zdravstveni problemi:" />
            <TextBox Text="{Binding HealthIssues}" PlaceholderText="Ostavite prazno ako nemate..." AcceptsReturn="True" Height="60" />

            <TextBlock Text="Ciljevi:" />
            <TextBox Text="{Binding Goals}" PlaceholderText="npr. Smršati 5kg..." AcceptsReturn="True" Height="60" />

            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding IsErrorVisible}" Foreground="Red" HorizontalAlignment="Center" Margin="0,10,0,0"/>

            <Button Content="Registruj se" Command="{Binding RegisterCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#007ACC" Foreground="White" Padding="10" Margin="0,15,0,0"/>

            <Button Content="Nazad na prijavu" Command="{Binding BackToLoginCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="Transparent" />
        </StackPanel>
    </ScrollViewer>
</Window>