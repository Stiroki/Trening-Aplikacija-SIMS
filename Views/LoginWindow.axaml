<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TreningAplikacija.Views.LoginWindow"
        Title="Prijava na Sistem" Width="400" Height="450"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="30" Spacing="15" VerticalAlignment="Center">
        
        <TextBlock Text="Dobrodošli" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="Email adresa:" />
        <TextBox Name="EmailTextBox" Watermark="Unesite email..." />

        <TextBlock Text="Lozinka:" />
        <TextBox Name="PasswordTextBox" Watermark="Unesite lozinku..." PasswordChar="*" />

        <TextBlock Name="ErrorTextBlock" Foreground="Red" IsVisible="False" HorizontalAlignment="Center"/>

        <Button Content="Prijavi se" Name="LoginButton" Click="LoginButton_Click" 
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#007ACC" Foreground="White" Padding="10" Margin="0,15,0,0"/>
        
        <Button Content="Nemate nalog? Registrujte se" Name="RegisterButton" Click="RegisterButton_Click"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="Transparent"/>
    </StackPanel>
</Window>